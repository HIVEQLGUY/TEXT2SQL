APP_NAME=TEXT2SQL
APP_ENV=local
APP_LOG_LEVEL=INFO

# Runtime metadata database.
META_DB_HOST=rm-example.mysql.rds.aliyuncs.com
META_DB_PORT=3306
META_DB_USER=meta_app
META_DB_PASSWORD=
META_DB_NAME=chatsql_ai
META_DB_CONNECT_TIMEOUT=10
META_DB_READ_TIMEOUT=30
META_DB_WRITE_TIMEOUT=30
META_DB_MYSQL_GET_SERVER_PUBLIC_KEY=true

# Read-only business data source used for generated SQL execution.
DW_DB_HOST=rm-example.mysql.rds.aliyuncs.com
DW_DB_PORT=3306
DW_DB_USER=readonly_user
DW_DB_PASSWORD=
DW_DB_NAME=chatsql_ai
DW_DB_CONNECT_TIMEOUT=10
DW_DB_READ_TIMEOUT=30
DW_DB_WRITE_TIMEOUT=30
DW_DB_MYSQL_GET_SERVER_PUBLIC_KEY=true

# OpenAI-compatible LLM endpoint. Real API keys belong in local .env only.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
